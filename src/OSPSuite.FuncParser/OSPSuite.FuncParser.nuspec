<?xml version="1.0"?>
<package>
  <metadata>
    <description>Function Parser for numeric and logic expressions</description>
    <id>OSPSuite.FuncParser</id>
    <version>$version$</version>
    <title>OSPSuite.FuncParser</title>
    <authors>Open-Systems-Pharmacology</authors>
    <owners>Open-Systems-Pharmacology</owners>
    <projectUrl>https://github.com/Open-Systems-Pharmacology/OSPSuite.FuncParser</projectUrl>
    <license type="file">LICENSE</license>
    <icon>logo.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>Copyright © 2024 - Open Systems Pharmacology Community</copyright>
    <tags>open-systems-pharmacology</tags>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="OSPSuite.Utility" version="5.0.0.6" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\LICENSE" />
    <file src="..\..\logo.png" />

    <file src="bin\Release\net10.0\OSPSuite.FuncParser.dll" target="lib\net10.0" />
    <file src="bin\Release\net10.0\OSPSuite.FuncParser.pdb" target="lib\net10.0" />

    <file src="..\..\runtimes\win-x64\native\OSPSuite.FuncParserNative.dll" target="runtimes\win-x64\native" />
    <file src="..\..\runtimes\linux-x64\native\libOSPSuite.FuncParserNative.so" target="runtimes\linux-x64\native" />
    <file src="..\..\runtimes\osx-arm64\native\libOSPSuite.FuncParserNative.dylib" target="runtimes\osx-arm64\native" />

    <file src="..\OSPSuite.FuncParserNative\include\**\*.h" target="OSPSuite.FuncParserNative\include" />
    <file src="..\OSPSuite.FuncParserNative\src\**\*.*" target="OSPSuite.FuncParserNative\src" />
    <file src="..\OSPSuite.FuncParserNative\*.*" target="OSPSuite.FuncParserNative" exclude="..\OSPSuite.FuncParserNative\*.vcxproj*" />
  </files>
</package>
