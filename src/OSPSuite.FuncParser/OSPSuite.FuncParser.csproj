<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OSPSuite.FuncParser</AssemblyName>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <InformationalVersion>1.0.0.0</InformationalVersion>
    <PackageProjectUrl>https://github.com/Open-Systems-Pharmacology/OSPSuite.FuncParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Open-Systems-Pharmacology/OSPSuite.FuncParser</RepositoryUrl>
    <PackageTags>open-systems-pharmacology, ospsuite-components</PackageTags>
    <Description>Function Parser for numeric and logic expressions</Description>
    <Authors>Open Systems Pharmacology Community</Authors>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Copyright>© Open Systems Pharmacology Community 2025</Copyright>
    <Product>OSPSuite FuncParser</Product>
    <Configurations>Debug;Release;Purify_Debug</Configurations>
    <NuspecFile>OSPSuite.FuncParser.nuspec</NuspecFile>
    <NuspecProperties>version=$(PackageVersion)</NuspecProperties>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OSPSuite.Utility" Version="5.0.0.6" />
  </ItemGroup>

  <!-- Surface the current-OS native binary as content so it propagates to projects that
       reference this one (tests, samples). The file is produced by the C++ build into
       runtimes/<rid>/native/ before this project is built (see buildNix.sh and the
       Windows native build step in the CI workflows). -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-x64\native\OSPSuite.FuncParserNative.dll"
             Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(MSBuildThisFileDirectory)..\..\runtimes\win-x64\native\OSPSuite.FuncParserNative.dll')"
             Link="OSPSuite.FuncParserNative.dll"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\runtimes\linux-x64\native\libOSPSuite.FuncParserNative.so"
             Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(MSBuildThisFileDirectory)..\..\runtimes\linux-x64\native\libOSPSuite.FuncParserNative.so')"
             Link="libOSPSuite.FuncParserNative.so"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\runtimes\osx-arm64\native\libOSPSuite.FuncParserNative.dylib"
             Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(MSBuildThisFileDirectory)..\..\runtimes\osx-arm64\native\libOSPSuite.FuncParserNative.dylib')"
             Link="libOSPSuite.FuncParserNative.dylib"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false" />
  </ItemGroup>

</Project>
